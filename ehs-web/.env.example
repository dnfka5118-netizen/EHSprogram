# Supabase 프로젝트 > Project Settings > API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용 (절대 외부 공개 금지) : 사용자 계정 생성·비밀번호 초기화에 사용
SUPABASE_SERVICE_ROLE_KEY=
# 신규 사용자 / 비밀번호 초기화 시 기본 비밀번호 (Supabase 최소 6자리)
INITIAL_PASSWORD=000000

# 사이트 주소 (메일의 바로가기 링크에 사용)
APP_URL=https://ehs.example.vercel.app

# 이메일 발송 (SMTP) : 회사 메일 서버 / Microsoft 365 / Google Workspace 등
#   Microsoft 365 예: SMTP_HOST=smtp.office365.com SMTP_PORT=587
#   Google 예:        SMTP_HOST=smtp.gmail.com     SMTP_PORT=465 (앱 비밀번호 사용)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="EHS 통합관리 <ehs@sypchem.co.kr>"

# Vercel Cron 인증용 임의 문자열 (아침 요약 메일)
CRON_SECRET=
